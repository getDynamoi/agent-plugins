{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "dynamoi",
  "version": "1.1.0",
  "description": "Music promotion and distribution, built for AI agents. Promote a song on Spotify or promote a video on YouTube, check campaign results, and make a free smart link for music or a free link in bio for musicians. Distribution is optional.",
  "author": {
    "name": "Dynamoi",
    "email": "support@dynamoi.com",
    "url": "https://dynamoi.com"
  },
  "homepage": "https://dynamoi.com/docs/mcp-server",
  "repository": "https://github.com/getDynamoi/agent-plugins",
  "license": "MIT",
  "keywords": [
    "music-promotion",
    "spotify-promotion",
    "youtube-promotion",
    "smart-links",
    "music-analytics",
    "music-distribution",
    "mcp"
  ],
  "extensions": {
    "com.nousresearch.hermes": {
      "servers": {
        "dynamoi": {
          "trust": "untrusted"
        }
      }
    }
  }
}
