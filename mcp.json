{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "dynamoi": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote@0.1.49",
        "https://dynamoi.com/mcp/directory?auth=required",
        "--transport",
        "http-only",
        "--static-oauth-client-info",
        "{\"client_id\":\"https://dynamoi.com/api/oauth/clients/hermes\"}"
      ]
    }
  }
}
